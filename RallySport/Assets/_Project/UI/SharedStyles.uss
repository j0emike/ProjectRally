
.button-shadow {
    background-color: #FDD35D;
    border-radius: 0px;
    margin-bottom: 30px;
    width: 400px;
    max-width: 90%;
    height: 80px;
}

.menu-button {
    translate: 5px -10px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/AlfaSlabOne/AlfaSlabOne-Regular SDF.asset");
    font-size: 48px;
    background-color: #FDCA40;
    border-width: 1px;
    border-color: #050505;
    color: #111111ff;
    width: 100%;
    height: 100%;
}

.menu-button:hover {
}

.menu-button:active {
    translate: 0px 0px;
}

.menu-button:disabled {
}



.buttons-container {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.button-shadow {
    background-color: rgba(0, 0, 0, 0.5);
    border-radius: 20px;
    margin-bottom: 16px;
    min-width: 12%;
    min-height: 10%;
}

.menu-button {
    font-size: 20px;
    background-color: rgb(55, 114, 255);
    border-radius: 20px;
    border-width: 1px;
    border-color: rgb(0, 0, 0);
    color: #DEDEDE;
    translate: 8px -8px;
    width: 100%;
    height: 100%;
}

.menu-button:hover {
}

.menu-button:active {
    translate: 0px 0px;
}

.menu-button:disabled {
}

.main-menu-container {
}

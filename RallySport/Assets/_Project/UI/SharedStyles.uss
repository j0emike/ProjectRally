
.button-shadow {
    background-color: #050505;
    border-radius: 20px;
    margin-bottom: 30px;
    width: 600px;
    max-width: 90%;
    height: 80px;
}

.menu-button {
    translate: 20px -20px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/AlfaSlabOne/AlfaSlabOne-Regular SDF.asset");
    font-size: 48px;
    background-color: #FDCA40;
    border-radius: 20px;
    border-width: 1px;
    border-color: #050505;
    color: #050505f8;
    width: 100%;
    height: 100%;
}

.menu-button:hover {
}

.menu-button:active {
    translate: 0px 0px;
}

.menu-button:disabled {
}


